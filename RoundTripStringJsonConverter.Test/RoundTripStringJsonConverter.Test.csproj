<Project>
  <Sdk Name="MSTest.Sdk" />
  <Sdk Name="ktsu.Sdk" />

  <PropertyGroup>
    <IsTestProject>true</IsTestProject>
    <TargetFramework>net10.0</TargetFramework>
    <TargetFrameworks></TargetFrameworks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\RoundTripStringJsonConverter\RoundTripStringJsonConverter.csproj" />
    <PackageReference Include="ktsu.Semantics.Strings" />
  </ItemGroup>

  <!--
    Build the netstandard2.0 asset too, and copy it to a subfolder of the test output, so NetStandardAssetTests
    can load it in isolation. The net10.0 asset referenced above is the one every other test runs against.
  -->
  <ItemGroup>
    <ProjectReference Include="..\RoundTripStringJsonConverter\RoundTripStringJsonConverter.csproj"
                      SetTargetFramework="TargetFramework=netstandard2.0"
                      ReferenceOutputAssembly="false"
                      OutputItemType="NetStandardAsset" />
  </ItemGroup>

  <Target Name="CopyNetStandardAsset" AfterTargets="ResolveProjectReferences">
    <Copy SourceFiles="@(NetStandardAsset)" DestinationFolder="$(OutDir)netstandard2.0" SkipUnchangedFiles="true" />
  </Target>

</Project>
